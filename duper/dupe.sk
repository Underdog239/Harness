# Simple item duper for Paper 1.21.x (requires the Skript plugin)
# Works for Java and Bedrock (Geyser/Floodgate) players.
# Install: put this file in plugins/Skript/scripts/ then run /sk reload dupe

options:
    cooldown: 3 seconds
    perm: dupe.use

command /dupe [<integer=1>]:
    description: Duplicate the item in your main hand.
    permission: {@perm}
    permission message: &cYou don't have permission to dupe.
    cooldown: {@cooldown}
    cooldown message: &cWait %remaining time% before duping again.
    trigger:
        if player's tool is air:
            send "&cHold an item to dupe."
            stop
        set {_n} to arg-1
        if {_n} < 1:
            set {_n} to 1
        if {_n} > 64:
            set {_n} to 64
        loop {_n} times:
            give player 1 of player's tool
        send "&aDuped %{_n}%x &f%type of player's tool%&a!"
